#!/usr/bin/env bash
# Drive a test reeve or a test hand to a dialog or to the end of a turn, so
# hall's alerts can be shown on demand (plan step 4; see docs/test-setup.md).
set -euo pipefail

HALL_PROG=test-drive
HALL_USAGE="usage: scripts/test-drive [options] <test reeve or test hand> dialog|turn-end|deny

  dialog    prompt the test claude to fetch a page with WebFetch, which no
            reeve office allows and claude's default permissions ask about,
            wait for hall to read it as blocked, and print hall's reading; the
            dialog is left standing
  turn-end  deny any standing dialog with Esc, prompt a direct question, wait
            for the turn to end, and print hall's reading
  deny      deny a standing dialog with Esc and print hall's reading

A dialog is never answered with allow.

With the reeve listing (--listing reeve), a hand the test reeve dispatched
itself is found by its errand id in reeve's listing.

options: --home, --session, --config, --listing, --dry-run, as for
scripts/test-setup"

# shellcheck source=test-setup-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/test-setup-lib.sh"

# A tool call claude asks about in every test claude: a test reeve or roster
# hand at claude's default permissions, and a hand a test reeve dispatched, at
# its office's (reeve's offices/*.settings.json). A file write is no use there:
# every office allows Write, with acceptEdits. No office allows WebFetch, and
# the liege's own settings allow it only for a few domains, example.com not
# among them. The dialog is denied with Esc, so nothing is fetched.
DIALOG_PROMPT="Use the WebFetch tool to fetch https://example.com/ and tell me the page title. Use no other tool."
TURN_PROMPT="What is 2 + 2? Reply with the number only, without using any tools."
WAIT_MS=120000
DENY_WAIT_MS=10000

parse_common "$@"
[ "${#REST[@]}" -eq 2 ] || usage_die "expected <test reeve or test hand> and one of dialog, turn-end, deny"
NAME=${REST[0]}
ACTION=${REST[1]}
case $ACTION in dialog | turn-end | deny) ;; *) usage_die "unknown action $ACTION" ;; esac
load_inputs

if roster_find "$NAME"; then
  loc=""
  run_into loc "$R_SESSION <pane-of-$NAME>" "$HALL_STANDIN" --home "$HALL_DEV_HOME" locate "$NAME" ||
    die "no pane recorded for $NAME; run scripts/test-setup up first"
  S=${loc%% *}
  P=${loc#* }
  if [ "$R_KIND" = reeve ]; then KIND="test reeve"; else KIND="test hand"; fi
elif [ "$HALL_DEV_LISTING" = reeve ]; then
  # A hand the test reeve dispatched itself: its pane is where reeve's listing
  # places it in the test hall session.
  listed=""
  run_into listed '{}' "${LISTING_CMD[@]}" || die "reeve's listing failed; see above"
  S=$HALL_DEV_SESSION
  P="<pane-of-$NAME>"
  if [ "$DRY_RUN" = 0 ]; then
    P=$(printf '%s' "$listed" | jq -r --arg id "$NAME" --arg s "$S" 'first(.errands[]? | select(.id == $id and .session.backend == "hall" and .session.name == $s) | .session.pane_id // empty) // empty')
    [ -n "$P" ] || die "$NAME is neither in the roster nor a hand reeve's listing places in $S"
    check_pane_id "$P" "reeve's listing for $NAME"
  fi
  KIND="test hand"
else
  die "$NAME is not in the roster"
fi
check_session "$S"
say "$KIND $NAME: pane $P in $S, action $ACTION"

deny() {
  hd "$S" agent send-keys "$P" esc
  # Hall reads the dialog for a moment after Esc and refuses a prompt while it
  # does (agent_blocked), so wait for the reading to leave blocked.
  hd "$S" agent wait "$P" --until idle --until done --until working --timeout "$DENY_WAIT_MS" ||
    say "  hall still reads a dialog after Esc; see the reading below"
}

case $ACTION in
  dialog)
    hd "$S" agent prompt "$P" "$DIALOG_PROMPT"
    hd "$S" agent wait "$P" --until blocked --timeout "$WAIT_MS" ||
      say "  agent wait did not see blocked; a dialog claude paints over the whole screen can read as idle, see the reading below"
    explain_report "$S" "$P"
    ;;
  turn-end)
    explain_report "$S" "$P"
    if [ "$DRY_RUN" = 1 ]; then
      say "  (only if the reading above is a dialog:)"
      deny
    elif [ "${EXPLAIN_STATE:-}" = blocked ] || { [[ ${EXPLAIN_STATE:-} =~ ^(idle|done)$ ]] && [ "${EXPLAIN_BOX:-}" != true ]; }; then
      deny
    fi
    # --wait needs observed activity before it settles, so an agent already idle
    # does not end the wait before the turn has started.
    hd "$S" agent prompt "$P" "$TURN_PROMPT" --wait --timeout "$WAIT_MS"
    explain_report "$S" "$P"
    ;;
  deny)
    deny
    explain_report "$S" "$P"
    ;;
esac
