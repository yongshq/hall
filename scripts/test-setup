#!/usr/bin/env bash
# Bring hall's test setup up or down, or report on it. See docs/test-setup.md.
set -euo pipefail

HALL_PROG=test-setup
HALL_USAGE="usage: scripts/test-setup [options] up|down|status

  up      start the test hall session if it is not running, seed the world
          file, start a claude session per roster line (each test reeve in a
          workspace of its own, each test hand a tab in its reeve's workspace),
          record where each one sits, print the listing; with the reeve
          listing, start the one test reeve and place no test hand
  down    stop the test hall session and forget the recorded panes
  status  read only: the test hall session, each recorded pane's hall reading,
          and scripts/live-check, the check that the live setup is untouched

options:
  --home <path>        test reeve home (else HALL_DEV_HOME from the config)
  --session <name>     test hall session (else HALL_DEV_SESSION)
  --listing <which>    standin or reeve: the listing the reeve tree reads
                       (else HALL_DEV_LISTING)
  --config <file>      config to source (default scripts/test-setup.conf)
  --delete             with down: also delete the stopped hall session's saved state
  --dry-run            print every command, run none"

# shellcheck source=test-setup-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/test-setup-lib.sh"

DELETE=0
args=()
for a in "$@"; do
  if [ "$a" = --delete ]; then DELETE=1; else args+=("$a"); fi
done
parse_common ${args[@]+"${args[@]}"}
[ "${#REST[@]}" -eq 1 ] || usage_die "expected one of up, down, status"
CMD=${REST[0]}
case $CMD in up | down | status) ;; *) usage_die "unknown command $CMD" ;; esac
[ "$DELETE" = 0 ] || [ "$CMD" = down ] || usage_die "--delete goes with down only"
# down and status still run on a home that fails only the walk inside it, so the
# test session can always be seen and stopped; up writes and launches, so it blocks.
case $CMD in down | status) HOME_WALK=warn ;; esac
load_inputs

WORLD="$HALL_DEV_HOME/standin/world.toml"
# The hall client config that turns the reeve tree on (decision 49): hall reads
# the listing by running LISTING_CMD, the stand-in's or reeve's, on this home.
CLIENT_CONFIG="$HALL_DEV_HOME/standin/hall.toml"
# How long up waits for a hall server it started to answer, in tenths of a
# second. HALL_START_WAIT overrides it (the tests do).
START_WAIT=${HALL_START_WAIT:-150}
[[ $START_WAIT =~ ^[0-9]+$ ]] || die "HALL_START_WAIT $START_WAIT: give tenths of a second, as a whole number"

# session_running <json> <name>: 0 when hall's session list shows it running.
session_running() {
  [ "$DRY_RUN" = 1 ] && return 0
  [ "$(printf '%s' "$1" | jq -r --arg n "$2" '.sessions[]? | select(.name == $n) | .running')" = true ]
}

# session_socket <json> <name>: the session's API socket path from hall's session list.
session_socket() {
  printf '%s' "$1" | jq -r --arg n "$2" '.sessions[]? | select(.name == $n) | .socket_path // empty'
}

# session_dir <json> <name>: the session's folder from hall's session list, or,
# for a session not listed yet, where hall puts it: under the default session's
# folder, in sessions/<name>.
session_dir() {
  printf '%s' "$1" | jq -r --arg n "$2" 'first(.sessions[]? | select(.name == $n) | .session_dir) // first(.sessions[]? | select(.default) | .session_dir + "/sessions/" + $n) // empty'
}

# start_session <name>: starts the hall server for that session, detached, and
# waits until hall's session list shows it running. Leaves the list in SESSIONS.
# The server runs without the STARTER_DROP names, so no pane or claude in it
# inherits them from whoever ran up (decision 48), and with REEVE_HOME set to
# the test reeve home: a hand a test reeve dispatches gets a tab whose
# environment is the server's, and reeve's launch line names no REEVE_HOME, so
# without it that hand's reeve hooks would write to the live ~/.reeve. Set in
# every listing mode, since a test reeve can dispatch through reeve's hall
# backend in either.
start_session() {
  local s=$1 i dir
  check_session "$s"
  detach "${HALL_CLEAN_ENV[@]}" "${SERVER_DROP[@]}" REEVE_HOME="$HALL_DEV_HOME" "$HALL_BIN" --session "$s" server
  if [ "$DRY_RUN" = 1 ]; then
    hall_session_list SESSIONS
    return 0
  fi
  say "+ $(q "${HALL_CLI[@]}" session list --json) (until $s is running, up to $((START_WAIT / 10)).$((START_WAIT % 10))s)"
  for ((i = 0; i < START_WAIT; i++)); do
    SESSIONS=$("${HALL_CLI[@]}" session list --json) || die "hall session list failed"
    session_running "$SESSIONS" "$s" && return 0
    sleep 0.1
  done
  dir=$(session_dir "$SESSIONS" "$s")
  die "hall session $s did not start within $((START_WAIT / 10)).$((START_WAIT % 10))s; its server log is in its session folder, ${dir:-not given by the session list}"
}

# server_has_home <socket>: 0 when every process holding the session's socket
# (lsof: the server; a client's end of a connection names no path) has the test
# reeve home as REEVE_HOME in its environment (ps eww). Otherwise 1, with
# SERVER_WHY saying what was found. A hall-dev server up did not start (the
# hall client starts one itself when none is listening) may lack it, and a hand
# a test reeve dispatches there would then write to another reeve home.
server_has_home() {
  local sock=$1 pids pid line found=0 re=' REEVE_HOME=([^ ]*) '
  say "+ $(q lsof -nP -t "$sock") (each pid: $(q ps eww -o command= -p '<pid>'))"
  pids=$(lsof -nP -t "$sock" 2>/dev/null) || true
  for pid in $pids; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    line=$(ps eww -o command= -p "$pid" 2>/dev/null) && [ -n "$line" ] || continue
    if [[ " $line " =~ $re ]]; then
      if [ "${BASH_REMATCH[1]}" != "$HALL_DEV_HOME" ]; then
        SERVER_WHY="its server, pid $pid, has REEVE_HOME=${BASH_REMATCH[1]}, not $HALL_DEV_HOME"
        return 1
      fi
    else
      SERVER_WHY="its server, pid $pid, has no REEVE_HOME"
      return 1
    fi
    found=1
  done
  [ "$found" = 1 ] && return 0
  SERVER_WHY="no process holding its socket $sock could be read (lsof, ps), so its REEVE_HOME is unknown"
  return 1
}

seed_world() {
  local text line
  text="# hall test setup world file: what the stand-in serves as the listing (version 1),
# and where the scripts record each test claude's pane (with the reeve listing,
# only that). Seeded by scripts/test-setup up from the roster. Edit freely, or use
# hall-standin --home <home> set <name> <key>=<value>. Format: docs/listing.md.
# herdr_session holds the hall session's name, listed as session.name with backend hall.
"
  for line in "${HALL_DEV_ROSTER[@]}"; do
    world_block "$line"
    text+=$WORLD_BLOCK
  done
  write_file "$WORLD" "$text"
}

# world_block <roster line>: sets WORLD_BLOCK to that line's entry in the world file.
world_block() {
  roster_read "$1"
  case $R_KIND in
    reeve)
      WORLD_BLOCK="
[[reeve]]
name = \"$R_NAME\"
herdr_session = \"$R_SESSION\"
live = true
"
      ;;
    errand)
      WORLD_BLOCK="
[[errand]]
id = \"$R_NAME\"
office = \"$R_OFFICE\"
owner = \"$R_OWNER\"
state = \"working\"
waiting = false
idle = false
wedged = false
in_flight = true
herdr_session = \"$R_SESSION\"
"
      ;;
  esac
}

# add_to_world: adds to an existing world file each roster line it does not name
# yet, keeping the rest as it is, so a home first brought up with one roster
# (the reeve listing's one test reeve) comes up with another.
add_to_world() {
  local text line added=""
  # A world file the stand-in cannot read is left alone: has would name nothing
  # in it, and every roster line would be added twice.
  if ! "$HALL_STANDIN" --home "$HALL_DEV_HOME" listing >/dev/null 2>&1; then
    say "  world file $WORLD exists and does not read, kept as it is"
    return 0
  fi
  text=$(<"$WORLD")
  for line in "${HALL_DEV_ROSTER[@]}"; do
    roster_read "$line"
    "$HALL_STANDIN" --home "$HALL_DEV_HOME" has "$R_NAME" 2>/dev/null && continue
    world_block "$line"
    text+=$WORLD_BLOCK
    added+=" $R_NAME"
  done
  if [ -n "$added" ]; then
    say "  world file $WORLD exists, kept as it is but for the roster lines it lacked:$added"
    write_file "$WORLD" "$text
"
  else
    say "  world file $WORLD exists, kept as it is"
  fi
}

# write_client_config: the hall client config naming LISTING_CMD, the stand-in's
# or reeve's listing of this home, as the reeve tree's listing command.
# Rewritten on every up, since it names the stand-in this checkout runs or the
# listing chosen. Attach with HALL_CONFIG_PATH set to it.
write_client_config() {
  local p
  for p in "${LISTING_CMD[0]}" "$HALL_DEV_HOME"; do
    # Each goes into a TOML string as it is, so it must be plain.
    [[ $p =~ ^/[A-Za-z0-9_./-]+$ ]] || die "refusing $(q "$p") in the hall client config: use letters, digits, '.', '_', '-' and '/' only"
  done
  write_file "$CLIENT_CONFIG" "# hall client config for the test setup, written by scripts/test-setup up.
# The reeve tree reads the $HALL_DEV_LISTING listing of the test reeve home (decision 49).
# Attach with HALL_CONFIG_PATH set to this file: see docs/test-setup.md.
# No first-run overlay: this config is the test view's, not a first run of hall.
onboarding = false

[reeve]
listing_command = [\"${LISTING_CMD[0]}\", \"--home\", \"$HALL_DEV_HOME\"]
"
}

# The workspace each test reeve sits in, by name, so its test hands open as
# tabs there. Parallel arrays: macOS bash 3.2 has no associative ones.
WS_NAMES=()
WS_IDS=()

ws_of() {
  local i
  for ((i = 0; i < ${#WS_NAMES[@]}; i++)); do
    [ "${WS_NAMES[$i]}" = "$1" ] && { printf '%s\n' "${WS_IDS[$i]}"; return 0; }
  done
  return 1
}

# up_line: brings up the test reeve or test hand in R_*, unless the world file
# already records a pane hall still has in the right session.
up_line() {
  local loc pane out ws created
  say "$R_KIND $R_NAME in $R_SESSION:"
  make_dir "$(work_dir "$R_NAME")"
  trust_report "$(work_dir "$R_NAME")"

  loc=""
  if run_into loc "" "$HALL_STANDIN" --home "$HALL_DEV_HOME" locate "$R_NAME" 2>/dev/null && [ -n "$loc" ]; then
    pane=${loc#* }
    if [ "${loc%% *}" = "$R_SESSION" ] && hd_into out "" "$R_SESSION" pane get "$pane" 2>/dev/null; then
      say "  already up in pane $pane"
      if [ "$R_KIND" = reeve ] && [ "$DRY_RUN" = 0 ]; then
        WS_NAMES+=("$R_NAME")
        WS_IDS+=("$(printf '%s' "$out" | jq -r '.result.pane.workspace_id // empty')")
      fi
      return 0
    fi
  fi

  if [ "$R_KIND" = reeve ]; then
    hd_into created '{}' "$R_SESSION" workspace create --cwd "$(work_dir "$R_NAME")" --label "$R_NAME" --no-focus
  else
    if [ "$DRY_RUN" = 1 ]; then
      ws="<workspace-of-$R_OWNER>"
    else
      ws=$(ws_of "$R_OWNER") && [ -n "$ws" ] || die "errand $R_NAME: its owner $R_OWNER is not a test reeve that is up, so it has no workspace to open a tab in"
    fi
    hd_into created '{}' "$R_SESSION" tab create --workspace "$ws" --cwd "$(work_dir "$R_NAME")" --label "$R_NAME" --no-focus
  fi
  if [ "$DRY_RUN" = 1 ]; then
    pane="<pane-of-$R_NAME>"
  else
    pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
    [ -n "$pane" ] || die "$R_KIND $R_NAME: hall gave no pane id: $created"
    check_pane_id "$pane" "hall's reply for $R_KIND $R_NAME"
    if [ "$R_KIND" = reeve ]; then
      WS_NAMES+=("$R_NAME")
      WS_IDS+=("$(printf '%s' "$created" | jq -r '.result.root_pane.workspace_id // empty')")
    fi
  fi
  hd "$R_SESSION" pane run "$pane" "$(claude_line "$R_KIND" "$R_NAME")"
  standin place "$R_NAME" "$R_SESSION" "$pane"
}

# print_listing: the listing the reeve tree reads, as it reads it now.
print_listing() {
  if [ "$HALL_DEV_LISTING" = reeve ]; then
    run "${LISTING_CMD[@]}"
  else
    standin listing
  fi
}

cmd_up() {
  local line
  if [ "$DRY_RUN" = 0 ]; then
    command -v jq >/dev/null || die "jq is not on PATH"
    command -v perl >/dev/null || die "perl is not on PATH"
  fi
  if [ -n "${HALL_STANDIN_BIN:-}" ]; then
    say "  stand-in: $HALL_STANDIN (HALL_STANDIN_BIN, not built here)"
  fi
  if [ -n "${HALL_DEBUG_BIN:-}" ]; then
    say "  hall: $HALL_BIN (HALL_DEBUG_BIN, not built here)"
  fi
  local build=()
  [ -n "${HALL_DEBUG_BIN:-}" ] || build+=(-p hall)
  [ -n "${HALL_STANDIN_BIN:-}" ] || build+=(-p hall-standin)
  if [ "${#build[@]}" -gt 0 ]; then
    say "  cargo: $HALL_RUSTUP_BIN and $HALL_ZIG_BIN put first on PATH (keg-only rustup and zig)"
    PATH="$HALL_RUSTUP_BIN:$HALL_ZIG_BIN:$PATH"
    run "${HALL_CLEAN_ENV[@]}" cargo build --quiet --manifest-path "$HALL_REPO/Cargo.toml" "${build[@]}"
  fi
  [ "$DRY_RUN" = 1 ] || [ -x "$HALL_BIN" ] || die "hall $HALL_BIN is not built"
  if [ "$HALL_DEV_LISTING" = reeve ] && [ "$DRY_RUN" = 0 ] && [ ! -x "$HALL_DEV_REEVE_LISTING" ]; then
    die "reeve's listing command $HALL_DEV_REEVE_LISTING is not there: it comes with reeve's hall backend (plan step 5); use --listing standin until it lands"
  fi

  hall_session_list SESSIONS
  if session_running "$SESSIONS" "$HALL_DEV_SESSION" && [ "$DRY_RUN" = 0 ]; then
    server_has_home "$(session_socket "$SESSIONS" "$HALL_DEV_SESSION")" ||
      die "hall session $HALL_DEV_SESSION is running, but $SERVER_WHY: a hand a test reeve dispatches there would write its reeve state outside the test home; scripts/test-setup down, then up, starts one that has REEVE_HOME=$HALL_DEV_HOME"
    say "  hall session $HALL_DEV_SESSION is running with REEVE_HOME=$HALL_DEV_HOME, kept as it is"
  else
    start_session "$HALL_DEV_SESSION"
  fi
  if [ "$DRY_RUN" = 1 ]; then
    HALL_DEV_SOCKET="<socket-of-$HALL_DEV_SESSION>"
  else
    HALL_DEV_SOCKET=$(session_socket "$SESSIONS" "$HALL_DEV_SESSION")
    # It goes into the command line each pane runs, so it must be plain.
    [[ $HALL_DEV_SOCKET =~ ^/[A-Za-z0-9_./-]+$ ]] || die "refusing hall session $HALL_DEV_SESSION's socket $(q "$HALL_DEV_SOCKET"): use letters, digits, '.', '_', '-' and '/' only"
  fi
  say "  socket: $HALL_DEV_SOCKET"

  make_dir "$HALL_DEV_HOME/standin"
  make_dir "$(xdg_dir)"
  make_dir "$(xdg_state_dir)"
  if [ "$DRY_RUN" = 1 ] || [ ! -e "$WORLD" ]; then
    seed_world
  else
    add_to_world
  fi
  write_client_config

  # Test reeves first, so each test hand has its reeve's workspace to open in.
  for line in "${HALL_DEV_ROSTER[@]}"; do
    roster_read "$line"
    [ "$R_KIND" = reeve ] && up_line
  done
  for line in "${HALL_DEV_ROSTER[@]}"; do
    roster_read "$line"
    [ "$R_KIND" = errand ] && up_line
  done

  say "listing:"
  print_listing || say "  CHECK: the listing command failed; see above"
  say "next: answer any folder trust dialog yourself, attached with this line, which shows the reeve tree and, should $HALL_DEV_SESSION have stopped, starts its server as up does:"
  say "  $(q "${HALL_CLEAN_ENV[@]}") $ATTACH_DROP $(q REEVE_HOME="$HALL_DEV_HOME" HALL_CONFIG_PATH="$CLIENT_CONFIG" "$HALL_BIN" --session "$HALL_DEV_SESSION")"
  say "then scripts/test-setup status"
}

cmd_down() {
  local sessions line s=$HALL_DEV_SESSION
  hall_session_list sessions
  check_session "$s"
  if session_running "$sessions" "$s"; then
    run "${HALL_CLI[@]}" session stop "$s" --json
  else
    say "  $s is not running"
  fi
  if [ "$DELETE" = 1 ]; then
    run "${HALL_CLI[@]}" session delete "$s" --json
  fi
  if [ "$HOME_WALKED" = 0 ]; then
    say "  recorded panes not forgotten: the test reeve home fails the check inside it, so its world file is left alone"
  elif [ "$DRY_RUN" = 1 ] || [ -e "$WORLD" ]; then
    for line in "${HALL_DEV_ROSTER[@]}"; do
      roster_read "$line"
      standin place "$R_NAME" "$R_SESSION"
    done
  fi
  say "the test reeve home $HALL_DEV_HOME is kept; remove it by hand if wanted"
}

cmd_status() {
  local sessions s line loc pane out rc=0
  hall_session_list sessions
  [ "$DRY_RUN" = 1 ] ||
    say "  $HALL_DEV_SESSION: $(printf '%s' "$sessions" | jq -c --arg n "$HALL_DEV_SESSION" '[.sessions[]? | select(.name == $n) | {running, socket_path}] | first // "not listed"')"
  if [ "$DRY_RUN" = 0 ] && session_running "$sessions" "$HALL_DEV_SESSION"; then
    if server_has_home "$(session_socket "$sessions" "$HALL_DEV_SESSION")"; then
      say "  $HALL_DEV_SESSION's server has REEVE_HOME=$HALL_DEV_HOME"
    else
      say "  CHECK: hall session $HALL_DEV_SESSION is running, but $SERVER_WHY: a hand a test reeve dispatches there would write its reeve state outside the test home; down, then up"
    fi
  fi

  say "test session:"
  [ "$HOME_WALKED" = 1 ] || say "  CHECK: recorded panes not read: the test reeve home fails the check inside it"
  for line in "${HALL_DEV_ROSTER[@]}"; do
    [ "$HOME_WALKED" = 1 ] || break
    roster_read "$line"
    if ! run_into loc "$R_SESSION <pane-of-$R_NAME>" "$HALL_STANDIN" --home "$HALL_DEV_HOME" locate "$R_NAME" 2>/dev/null; then
      say "  $R_KIND $R_NAME: no pane recorded"
      continue
    fi
    pane=${loc#* }
    s=${loc%% *}
    if ! (check_session "$s") 2>/dev/null; then
      say "  CHECK: $R_KIND $R_NAME is recorded in hall session $s, which is not a test hall session"
      continue
    fi
    if ! session_running "$sessions" "$s"; then
      say "  $R_KIND $R_NAME: pane $pane recorded, but $s is not running"
      continue
    fi
    if hd_into out "{}" "$s" pane get "$pane" 2>/dev/null; then
      [ "$DRY_RUN" = 1 ] || say "  $R_KIND $R_NAME: pane $pane is in $s, $(printf '%s' "$out" | jq -r '"workspace \(.result.pane.workspace_id), tab \(.result.pane.tab_id)"')"
      explain_report "$s" "$pane"
    else
      say "  CHECK: $R_KIND $R_NAME: pane $pane not found in $s"
    fi
  done

  say "folder trust:"
  for line in "${HALL_DEV_ROSTER[@]}"; do
    roster_read "$line"
    trust_report "$(work_dir "$R_NAME")"
  done

  if [ "$HOME_WALKED" = 0 ]; then
    say "listing: not read, the test reeve home fails the check inside it"
  elif [ "$DRY_RUN" = 1 ] || { [ -x "${LISTING_CMD[0]}" ] && { [ "$HALL_DEV_LISTING" = reeve ] || [ -e "$WORLD" ]; }; }; then
    say "listing:"
    print_listing || true
  fi

  # The live setup check is its own tool, which makes no herdr call (decision 40).
  say "live setup:"
  run "$HALL_REPO/scripts/live-check" || rc=$?
  if [ "$rc" != 0 ]; then
    say "  CHECK: scripts/live-check failed (exit status $rc); see above"
    return 1
  fi
}

"cmd_$CMD"
